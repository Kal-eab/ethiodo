# Vite fingerprints everything in assets/ (index-BmCjS-Cq.js), so those files
# can be cached forever — a new deploy produces new filenames. Without this,
# Pages serves them with max-age=0 and every visitor re-downloads the bundle.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must never be cached hard, or visitors keep loading the old
# bundle's asset URLs after a deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
